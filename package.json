{
  "name": "pennywise",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo prebuild --clean && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "rm -rf .expo node_modules",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "doctor": "expo-doctor --verbose",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "update-packages": "expo install --check",
    "reinstall-packages": "rm -rf node_modules bun.lock && bun i",
    "typecheck": "tsc --noEmit",
    "build": "bun run prebuild && ./android/gradlew -p android assembleRelease",
    "prebuild": "expo prebuild --clean",
    "build:arm64": "./android/gradlew -p android assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:x86_64": "./android/gradlew -p android assembleRelease -PreactNativeArchitectures=x86_64",
    "build:universal": "./android/gradlew -p android assembleRelease -PreactNativeArchitectures=arm64-v8a,x86_64",
    "build:arm64:install": "bun run build:arm64 && bun run install-apk",
    "build:x86_64:install": "bun run build:x86_64 && bun run install-apk",
    "build:universal:install": "bun run build:universal && bun run install-apk",
    "install-apk": "adb install ./android/app/build/outputs/apk/release/app-release.apk",
    "update-apk": "adb install -r ./android/app/build/outputs/apk/release/app-release.apk",
    "build:install-apk": "bun run build && bun run install-apk"
  },
  "dependencies": {
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/aspect-ratio": "^1.5.2",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/collapsible": "^1.5.2",
    "@rn-primitives/context-menu": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/hover-card": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/menubar": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@rn-primitives/toggle": "^1.5.2",
    "@rn-primitives/toggle-group": "^1.5.2",
    "@rn-primitives/tooltip": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^57.0.9",
    "expo-constants": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "lucide-react-native": "^1.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "uniwind": "^1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@biomejs/biome": "^2.5.14",
    "@types/react": "~19.2.10",
    "expo-doctor": "^1.20.4",
    "lefthook": "^2.1.14",
    "typescript": "~6.0.3"
  },
  "private": true
}
